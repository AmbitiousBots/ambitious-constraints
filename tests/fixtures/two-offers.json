{
  "schema": "constraint-model.v1",
  "name": "two-offers",
  "description": "Pick at most one offer and stay inside the hours available.",
  "variables": [
    { "name": "offer_basic", "type": "bool" },
    { "name": "offer_full", "type": "bool" },
    { "name": "hours", "type": "int", "domain": { "lo": 0, "hi": 40 } },
    { "name": "tier", "type": "enum", "domain": { "values": ["none", "basic", "full"] } }
  ],
  "params": [{ "name": "hours_available", "value": 20, "unit": "hours per week" }],
  "constraints": [
    { "id": "one_offer", "kind": "at_most_one", "args": { "lits": ["offer_basic", "offer_full"] }, "strength": "structural", "category": "definition" },
    {
      "id": "tier_matches",
      "kind": "implication",
      "args": { "rows": [
        { "if": ["offer_full"], "then": ["tier=full"] },
        { "if": ["offer_basic"], "then": ["tier=basic"] },
        { "if": ["!offer_full", "!offer_basic"], "then": ["tier=none"] }
      ] },
      "strength": "structural",
      "category": "definition"
    },
    { "id": "hours_fit", "kind": "linear", "args": { "terms": [[1, "hours"]], "op": "<=", "rhs": "param:hours_available" }, "strength": "hard", "category": "assumption", "negotiable": false, "label": "Work fits in the hours available" },
    { "id": "full_needs_hours", "kind": "linear", "args": { "terms": [[1, "hours"]], "op": ">=", "rhs": 30, "if": ["offer_full"] }, "strength": "hard", "category": "fact", "label": "The full offer takes 30 hours" },
    { "id": "basic_needs_hours", "kind": "linear", "args": { "terms": [[1, "hours"]], "op": ">=", "rhs": 10, "if": ["offer_basic"] }, "strength": "hard", "category": "fact", "label": "The basic offer takes 10 hours" },
    { "id": "want_full", "kind": "fix", "args": { "lit": "offer_full" }, "strength": "hard", "category": "desire", "negotiable": true, "label": "Sell the full offer" }
  ],
  "evidence": [
    { "target": { "param": "hours_available" }, "source": "planning note", "confidence": "assumption" },
    { "target": { "constraint": "full_needs_hours" }, "source": "time sheet of the last three projects", "confidence": "sourced", "quote": "28, 30 and 33 hours" },
    { "target": { "constraint": "basic_needs_hours" }, "source": "time sheet of the last three projects", "confidence": "derived", "inputs": ["full_needs_hours"] }
  ],
  "objective": { "sense": "max", "terms": [{ "coef": 3000, "var": "offer_full" }, { "coef": 1000, "var": "offer_basic" }, { "coef": -10, "var": "hours" }] },
  "scenarios": [
    { "name": "more_hours", "description": "A second person adds 15 hours", "overrides": { "params": { "hours_available": 35 } } },
    { "name": "full_is_a_wish", "description": "Selling the full offer becomes a preference worth 500", "overrides": { "soften": { "want_full": 500 } } }
  ]
}
